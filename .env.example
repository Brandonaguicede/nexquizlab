NODE_ENV=development
POSTGRES_USER=nexquiz_admin
POSTGRES_PASSWORD=CHANGE_POSTGRES_PASSWORD
AUTH_DB_USER=nexquiz_auth
AUTH_DB_PASSWORD=CHANGE_AUTH_DB_PASSWORD
GAME_DB_USER=nexquiz_game
GAME_DB_PASSWORD=CHANGE_GAME_DB_PASSWORD
POSTGRES_PORT=5432
AUTH_PORT=3001
GAME_PORT=3002
WEB_PORT=8080
# Maximum simultaneous participants per room; set to the load-tested value (Hito 6).
GAME_MAX_PARTICIPANTS=50
AUTH_DATABASE_URL=postgresql://nexquiz_auth:CHANGE_AUTH_DB_PASSWORD@localhost:5432/nexquiz_auth?schema=public&connect_timeout=5&pool_timeout=5
GAME_DATABASE_URL=postgresql://nexquiz_game:CHANGE_GAME_DB_PASSWORD@localhost:5432/nexquiz_game?schema=public&connect_timeout=5&pool_timeout=5
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_AUTH_API_URL=http://localhost:3001
VITE_GAME_API_URL=http://localhost:3002
JWT_ISSUER=https://auth.nexquiz.example
JWT_AUDIENCE=nexquiz-game-api
JWT_KEY_ID=nexquiz-key-1
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
GRAFANA_USER=nexquiz
GRAFANA_PASSWORD=CHANGE_GRAFANA_PASSWORD
# Independent results client (Hito 5). Its browser origin is appended to CORS_ORIGINS by Compose.
RESULTS_CLIENT_PORT=8081
# Public URL of the web proxy as seen by browsers (used by the results client).
PUBLIC_WEB_URL=http://localhost:8080
RESULTS_CLIENT_ORIGIN=http://localhost:8081
# Demo data loaded through the APIs on every start (idempotent). Test accounts only; setup generates the password.
DEMO_SEED=true
DEMO_EMAIL_DOMAIN=nexquiz.demo
DEMO_PASSWORD=CHANGE_DEMO_PASSWORD
# Docker Hub namespace for publishing (release:build) and for start --hub. Images: <user>/nexquiz-<app>:<tag>.
DOCKERHUB_USER=brandonwilmer
IMAGE_TAG=0.1.0
# Match the VPS CPU; build the same target used by production Compose.
DOCKER_PLATFORM=linux/amd64
SITE_ADDRESS=localhost
