{
  "name": "nexquiz-game-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --env-file=../../.env --watch -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "generate": "node ../../scripts/prisma.cjs game generate",
    "db:deploy": "node ../../scripts/prisma.cjs game deploy",
    "test": "jest --runInBand",
    "db:validate": "node ../../scripts/prisma.cjs game validate",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "@nestjs/common": "11.1.12",
    "@nestjs/core": "11.1.12",
    "@nestjs/platform-express": "11.1.12",
    "@nestjs/platform-socket.io": "11.1.12",
    "@nestjs/swagger": "11.2.5",
    "@nestjs/websockets": "11.1.12",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.70.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.211.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.211.0",
    "@opentelemetry/sdk-metrics": "2.5.0",
    "@opentelemetry/sdk-node": "0.211.0",
    "@prisma/client": "6.19.0",
    "@scalar/nestjs-api-reference": "1.0.27",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.12",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "24.10.9",
    "@types/supertest": "6.0.3",
    "jest": "30.2.0",
    "prisma": "6.19.0",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
